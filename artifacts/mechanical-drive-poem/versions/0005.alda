(tempo! 72)
(key-signature! "f+ c+")

# 核心动机 (D大调化)
spin1 = [d+5 e5 f+5 a5 f+5 e5 d+5 e5]
spin2 = [d5 e5 f+5 a5 f+5 e5 d5 e5]
pad1 = [d5 f+5 a5 c+6]
pad2 = [e5 g5 b5 d6]
pad3 = [g5 b5 d6 f+6]
callUp = [a5 b5 c+6 d6]
callDn = [c+6 b5 a5 g5]
armr = [d4 e4 f+4 a4 d4 e4 f+4 a4]
motor = [d8 r8 d8 r8 d8 r8 d8 r8]
mtr2 = [d8 d8 r8 d8 d8 r8 d8 d8]
coldM = [d5 e5 f+5 g5 f+5 e5 d5 e5]
cbass = [g1 f+1 e1 d1]
ascend = [d7 r8 f+7 r8 a7 r8 d+7 r8]

# ========== I 飞旋，飞旋！(明亮自转 · 64拍) ==========
midi-glockenspiel:
o6 (volume 72)
spin1 * 3 spin2 * 2 spin1 spin2 * 2

midi-tubular-bells:
o4 (volume 50) motor * 8 mtr2 * 4

midi-marimba:
o4 (volume 58) r1 * 4 d2 a2 b2 d2 a2 d2

midi-electric-bass-finger:
o2 (volume 52) r1 * 4 d2 a2 b2 d2 a2 d2

midi-french-horn:
o4 (volume 56) r1 * 6 d4 f+4 a4 c+5 d5 c+5 a4 f+4

midi-cello:
o3 (volume 42) r1 * 12

midi-violin:
o5 (volume 56) r1 * 12

midi-vibraphone:
o5 (volume 60) r1 * 12

midi-trumpet:
o5 (volume 62) r1 * 12

# ========== II 银白明亮之海 (数据矩阵 · 32拍) ==========
midi-glockenspiel:
o6 (volume 54) r1 * 4 spin2

midi-tubular-bells:
o4 (volume 42) motor * 4 mtr2 * 2

midi-marimba:
o4 (volume 46) a2 e2 a2 d2 g2 d2 f+2 d2

midi-electric-bass-finger:
o2 (volume 44) r1 * 8

midi-cello:
o3 (volume 46) r1 * 4 a4 c+5 f+5 a5 c+6 a5 f+5 c+5

midi-vibraphone:
o5 (volume 62) pad1 pad2 pad3 pad1 pad2 pad1 r2 r2

midi-french-horn:
o4 (volume 44) r1 * 4 d4 r8 f+4 r8 a4 r8 d5 r8

midi-violin:
o5 (volume 58)
e5 f+5 g5 a5 b5 a5 f+5 e5 f+5 g5 a5 c+6 b5 a5 g5 a5
a4 b4 c+5 e5 d5 b4 a4 f+4 a4 b4 c+5 d5 e5 f+5 d5 e5

midi-trumpet:
o5 (volume 40) r1 * 8

# ========== III 磁通呼唤悬臂 (律动苏醒 · 40拍) ==========
midi-glockenspiel:
o6 (volume 56) r1 * 2 coldM * 2 coldM * 2

midi-tubular-bells:
