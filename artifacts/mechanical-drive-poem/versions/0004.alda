(tempo! 71)

# 核心动机
spin1 = [c+8 d+8 c+8 e8 c+8 f8 c+8 e8]
spin2 = [c8 d8 c8 e8 c8 f8 c8 e8]
pad1 = [c5 e-5 g5 b5]
pad2 = [a5 c6 e-6 g6]
pad3 = [e-5 g5 b-5 d6]
callUp = [g5 a-5 b-5 c6]
callDn = [b-5 a-5 g5 f5]
armr = [c4 d4 e-4 g4 c4 d4 e-4 g4]
motor = [c8 r8 c8 r8 c8 r8 c8 r8]
mtr2 = [c8 c8 r8 c8 c8 r8 c8 c8]
coldM = [c5 c+5 d5 e-5 d5 c+5 c5 d5]
cbass = [a-1 g1 f1 e-1]
ascend = [c7 r8 e7 r8 g7 r8 b7 r8]

# ========== I 飞旋，飞旋！(机械自转 · 64拍) ==========
midi-glockenspiel:
o6 (volume 68)
spin1 * 3 spin2 * 2 spin1 spin2 * 2

midi-tubular-bells:
o4 (volume 52) motor * 8 mtr2 * 4

midi-contrabass:
o2 (volume 46) c1 * 12

midi-electric-bass-finger:
o2 (volume 60) r1 * 4 c2 g2 a-2 c2 g2 c2

midi-french-horn:
o4 (volume 58) r1 * 6 c4 e-4 g4 b-4 c5 b-4 g4 e-4

midi-cello:
o3 (volume 42) r1 * 12

midi-violin:
o5 (volume 52) r1 * 12

midi-vibraphone:
o5 (volume 58) r1 * 12

midi-trumpet:
o5 (volume 62) r1 * 12

