(tempo! 96)

spinGlow = [c+8 d+8 c+8 e8 c+8 f8 c+8 e8]
spinGlow2 = [c8 d8 c8 e8 c8 f8 c8 e8]
coldPad = [c5 e-5 g5 b5]
coldPad2 = [a5 c6 e-6 g6]
callMot = [g5 a-5 b-5 c6]
callMot2 = [b-5 a-5 g5 f5]
armRise = [c4 d4 e-4 g4 c4 d4 e-4 g4]
motorPat = [c8 r8 c8 r8 c8 r8 c8 r8]
driveLine = [c2 e-2]
coldMach = [c5 c+5 d5 e-5 d5 c+5 c5 d5]
coldBass = [a-1 g1 f1 e-1]

# ============ 第一乐章: 飞旋, 飞旋! (48拍) ============
midi-glockenspiel:
o6 (volume 70) spinGlow * 4 spinGlow2 * 4 spinGlow * 2 spinGlow2 * 2

midi-tubular-bells:
o4 (volume 55) motorPat * 12

midi-contrabass:
o2 (volume 45) c1 * 12

midi-cello:
o3 (volume 40) r1 * 12

midi-vibraphone:
o5 (volume 60) r1 * 12

midi-violin:
o5 (volume 55) r1 * 12

midi-trumpet:
o5 (volume 70) r1 * 12

midi-french-horn:
o4 (volume 55) r1 * 12

midi-electric-bass-finger:
o2 (volume 65) r1 * 12

# ============ 第二乐章: 银白冰冷之海 (24拍) ============
midi-glockenspiel:
o6 (volume 55) r1 * 6

midi-tubular-bells:
o4 (volume 45) motorPat * 6

midi-contrabass:
o2 (volume 40) c1 c1 a-1 c1 c1 c1

midi-cello:
o3 (volume 40) r1 * 6

midi-vibraphone:
o5 (volume 60) coldPad coldPad2 coldPad coldPad2 coldPad coldPad2

midi-violin:
o5 (volume 55) c5 d-5 e-5 f5 g5 e-5 c5 d-5 c5 d-5 e-5 f5 g5 a-5 g5 e-5 b-4 c5 d-5 f5 e-5 c5 d-5 b-4

midi-trumpet:
o5 (volume 50) r1 * 6

midi-french-horn:
o4 (volume 50) r1 * 6

midi-electric-bass-finger:
o2 (volume 40) r1 * 6

# ============ 第三乐章: 磁通呼唤 (32拍) 更冰冷更机械 ============
midi-glockenspiel:
o6 (volume 50) r1 * 4 coldMach * 2 coldMach * 2

midi-tubular-bells:
o4 (volume 60) motorPat * 8

midi-contrabass:
o2 (volume 45) coldBass * 8

midi-cello:
o3 (volume 45) r2 r2 r2 r2 c2 c+2 d2 e-2 armRise * 2

midi-vibraphone:
o5 (volume 45) r1 * 4 coldPad coldPad2 coldPad coldPad2

midi-violin:
o5 (volume 55) r1 r1 r1 r1 c+6 d6 e-5 f5 g5 e-5 f5 e5 d5 c+5 g5 f5 e5 d5 c+5 d5

midi-trumpet:
o5 (volume 65) r1 * 4 callMot callMot2 callMot2 callMot2

midi-french-horn:
o4 (volume 45) r1 * 4 c4 r8 e-4 r8 g4 r8 b-4 r8 c4 r8 e-4 r8 g4 r8 b-4 r8 c4 r8 e-4 r8 g4 r8 b-4 r8 c4 r8 e-4 r8 g4 r8 b-4 r8

midi-electric-bass-finger:
o2 (volume 45) r1 * 8

# ============ 第四乐章: 加速! 加速! (40拍) ============
(tempo! 136)

midi-glockenspiel:
o6 (volume 60) r1 * 10

midi-tubular-bells:
